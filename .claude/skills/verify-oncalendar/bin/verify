#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
skill="$root/.claude/skills/verify-oncalendar"
probe_target="$root/target/verify-probe"
caller_dir=$PWD
cd "$root"

evidence_dir() {
	dir="$root/.verify/$(date -u +%Y%m%dT%H%M%SZ)-$1"
	[ ! -e "$dir" ] || dir="$dir-$$"
	mkdir -p "$dir"
	printf '%s\n' "$dir"
}

build_probe() {
	CARGO_TARGET_DIR="$probe_target" cargo build --quiet --release --manifest-path "$skill/probe/Cargo.toml"
}

count_rows() {
	grep -vc -e '^#' -e '^$' "$1" || true
}

compare_into() {
	dir=$1
	cat > "$dir/cases.tsv"
	total=$(count_rows "$dir/cases.tsv")
	if ! oracle/run.sh < "$dir/cases.tsv" > "$dir/oracle.tsv" 2> "$dir/oracle.stderr"; then
		echo "broken: the oracle failed (see $dir/oracle.stderr)" | tee "$dir/summary.txt"
		return 3
	fi
	if ! "$probe_target/release/oncalendar-probe" < "$dir/cases.tsv" > "$dir/crate.tsv" 2> "$dir/crate.stderr"; then
		echo "broken: the probe exited with a failure, the library may have panicked (see $dir/crate.stderr)" | tee "$dir/summary.txt"
		return 3
	fi
	if awk -F '\t' '$4 == "bad-input" { found = 1 } END { exit !found }' "$dir/crate.tsv"; then
		echo "broken: the probe could not read the zone or base time of a case (see $dir/crate.tsv)" | tee "$dir/summary.txt"
		return 3
	fi
	awk -F '\t' 'NR > 1 && $4 == "unresolved" { print NR }' "$dir/oracle.tsv" > "$dir/unresolved.lines"
	reduce() {
		awk -F '\t' -v OFS='\t' 'FILENAME == ARGV[1] { skip[$1] = 1; next }
			FNR == 1 { next }
			FNR in skip { print $1, $2, $3, ($4 == "error" ? "rejected" : "accepted"); next }
			{ print }' "$dir/unresolved.lines" "$1"
	}
	reduce "$dir/oracle.tsv" > "$dir/oracle.body"
	reduce "$dir/crate.tsv" > "$dir/crate.body"
	oracle_rows=$(count_rows "$dir/oracle.body")
	crate_rows=$(count_rows "$dir/crate.body")
	if [ "$oracle_rows" -ne "$total" ] || [ "$crate_rows" -ne "$total" ]; then
		echo "broken: $total cases, but the oracle answered $oracle_rows and the crate $crate_rows" | tee "$dir/summary.txt"
		return 3
	fi
	unresolved=$(grep -c '' "$dir/unresolved.lines" || true)
	if diff -u "$dir/oracle.body" "$dir/crate.body" > "$dir/diff.txt"; then
		differing=0
	else
		differing=$(grep -c '^-[^-]' "$dir/diff.txt" || true)
		[ "$differing" -gt 0 ] || differing=1
	fi
	{
		head -n 1 "$dir/oracle.tsv"
		head -n 1 "$dir/crate.tsv"
		echo "cases: $total, differing: $differing, unresolved by systemd: $unresolved"
	} | tee "$dir/summary.txt"
	echo "evidence: $dir"
	[ "$differing" -eq 0 ]
}

case "${1:-}" in
doctor)
	fail=0
	check() {
		label=$1
		shift
		if "$@" >/dev/null 2>&1; then echo "ok    $label"; else echo "FAIL  $label"; fail=1; fi
	}
	check "cargo is installed" cargo --version
	check "docker daemon answers" docker info
	check "the crate builds with default features" cargo build --quiet
	check "the crate builds with no default features" cargo build --quiet --no-default-features
	check "the probe builds against the public API" build_probe
	check "the oracle image builds and answers" sh -c 'printf "UTC\t2026-01-01 00:00:00 UTC\tdaily\n" | oracle/run.sh 1 | grep -q "2026-01-02T00:00:00Z"'
	check "cargo-deny is installed" cargo deny --version
	check "cargo-hack is installed" cargo hack --version
	check "cargo-minimal-versions is installed" cargo minimal-versions --version
	check "actionlint is installed" actionlint -version
	check "zizmor is installed" zizmor --version
	echo "checkout: $root"
	echo "rustc: $(rustc --version)"
	exit "$fail"
	;;
one)
	[ $# -eq 4 ] || { echo "usage: verify one <tz> <base> <expression>" >&2; exit 2; }
	build_probe
	dir=$(evidence_dir one)
	printf '%s\t%s\t%s\n' "$2" "$3" "$4" | compare_into "$dir" && status=0 || status=$?
	[ "$status" -eq 3 ] && exit 3
	echo "--- systemd"; tail -n 1 "$dir/oracle.tsv"
	echo "--- oncalendar"; tail -n 1 "$dir/crate.tsv"
	exit "$status"
	;;
compare)
	cases=${2:-$root/tests/fixtures/cases.tsv}
	case "$cases" in /*) ;; *) cases="$caller_dir/$cases" ;; esac
	build_probe
	dir=$(evidence_dir compare)
	compare_into "$dir" < "$cases" && status=0 || status=$?
	[ "$status" -ne 1 ] || { echo "--- first differences"; grep '^[+-][^+-]' "$dir/diff.txt" | head -n 20; }
	exit "$status"
	;;
gates)
	dir=$(evidence_dir gates)
	fail=0
	gate() {
		name=$1
		shift
		if "$@" > "$dir/$name.txt" 2>&1; then echo "PASS  $name"; else echo "FAIL  $name   (see $dir/$name.txt)"; fail=1; fi
	}
	gate fmt cargo fmt --check
	gate no-comments scripts/check-no-comments.sh
	gate features scripts/check-features.sh
	gate minimal-versions scripts/check-minimal-versions.sh
	gate package scripts/check-package.sh
	gate workflows scripts/check-workflows.sh
	gate test-default cargo test --all-features
	gate test-no-default cargo test --no-default-features
	gate security scripts/check-security.sh
	gate weight scripts/check-weight.sh
	gate no-std scripts/check-no-std.sh
	gate oracle-drift oracle/check.sh
	echo "evidence: $dir"
	exit "$fail"
	;;
clean)
	rm -rf "$probe_target"
	echo "removed $probe_target"
	echo "kept    $root/.verify"
	;;
*)
	cat <<'USAGE'
Verification helper for the oncalendar crate. Run from any directory.

  verify doctor                         check that this checkout can be verified
  verify one <tz> <base> <expression>   compare one case against real systemd
  verify compare [cases.tsv]            compare a whole case file (default: tests/fixtures/cases.tsv)
  verify gates                          run the tests and every gate
  verify clean                          remove build output of this helper; evidence is kept

Evidence goes to .verify/<UTC timestamp>-<command>/ in the repository root.
Exit code 0 means the check passed, 1 a difference, 3 a side that did not answer.
USAGE
	exit 2
	;;
esac
